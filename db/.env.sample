# タイムゾーン
TZ=Asia/Tokyo

# PostgreSQL 設定値
POSTGRES_DB=coursenavigator
POSTGRES_USER=admin
POSTGRES_PASSWORD=secure_password_please_change

# Neo4j 設定値 (フォーマット: ユーザー名/パスワード)
NEO4J_AUTH=neo4j/secure_password_please_change

# ルーティングに使用するドメイン
DOMAIN=course-navigator.localhost

# ホスト側バインドIP（デフォルト: 127.0.0.1）
# 本番環境での意図しないポート外部露出を防ぐため、ループバックアドレスに限定しています。
DB_BIND_IP=127.0.0.1
