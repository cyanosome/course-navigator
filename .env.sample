# 共通タイムゾーン
TZ=Asia/Tokyo

# ルーティングに使用するドメイン
# プロキシ側 (proxy/.env) の DOMAIN 設定と一致させてください。
# ローカル開発時: course-navigator.localhost
# 本番デプロイ時: yourdomain.com
DOMAIN=course-navigator.localhost

# Database connection settings (for backend)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=coursenavigator
DB_USER=admin
DB_PASSWORD=secure_password_please_change

# Neo4j connection settings (for backend)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secure_password_please_change

# backend 起動時に空の DB へ seed/courses.json（ダミー20科目）を自動投入するか（ADR-0013）
# 既定は false。実データ（Ingestion 済み）の DB では false のまま。手動投入: uv run python -m course_core.seeder（backend コンテナ内）
AUTO_SEED_DATA=false

# --- LLM Agent Settings (Google ADK & Neo4j MCP) ---
GEMINI_API_KEY="gemini"

# Agent Model and parameters
AGENT_TEMPERATURE="0.2"
AGENT_ENABLE_MCP="true"
AGENT_INSTRUCTION_PATH="src/agent/prompts/compose_answer.md"
